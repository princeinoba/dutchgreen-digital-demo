# No environment variable is required for the read-only portfolio demo.
# Public canonical URL used by the generated sitemap. Vercel's system URL is
# used automatically when this value is omitted from a Vercel deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo-only public flag reserved for future integration gates. Keep true for
# every portfolio deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Optional server-only resources reserved for a later production-integration
# phase. Do not populate them until their corresponding feature is implemented.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
